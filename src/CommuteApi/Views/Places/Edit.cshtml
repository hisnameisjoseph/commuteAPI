@model CommuteApi.Models.PlaceForm
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<h1 class="h3 mb-3">Edit place</h1>

<form asp-action="Edit" asp-route-id="@ViewData["PlaceId"]" method="post" class="col-lg-8">
    <partial name="_PlaceFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
